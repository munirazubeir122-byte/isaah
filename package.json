{
  "name": "islaah-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "images": "node scripts/prepare-images.mjs",
    "illustrations": "node scripts/make-illustrations.mjs",
    "audio": "node scripts/generate-audio.mjs",
    "audio:edge": "node scripts/generate-audio.mjs --edge",
    "worker": "npm run build && wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply islaah --local",
    "db:migrate:remote": "wrangler d1 migrations apply islaah --remote",
    "admin:invite": "node scripts/admin-invite.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.69.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@cloudflare/workers-types": "^5.20261110.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "mpg123-decoder": "^1.0.3",
    "msedge-tts": "^2.1.1",
    "oxlint": "^1.90.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.4",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "wrangler": "^4.159.0"
  },
  "allowScripts": {
    "msedge-tts": false
  }
}
